{
    "name": "svandragt/htmxpress-serverside-block",
    "license": "GPL-2.0-or-later",
    "require-dev": {
        "phpunit/phpunit": "^13",
        "brain/monkey": "^2"
    },
    "autoload-dev": {
        "psr-4": {
            "Yak\\HtmxServerBlock\\Tests\\Unit\\": "tests/Unit/"
        }
    },
    "scripts": {
        "test": "php -d pcov.directory=. vendor/bin/phpunit",
        "test:coverage": [
            "php -d pcov.directory=. vendor/bin/phpunit --coverage-clover coverage/clover.xml",
            "php bin/coverage-check.php 50"
        ]
    },
    "config": {
        "sort-packages": true
    }
}

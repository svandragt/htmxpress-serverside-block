{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": [
    "nodejs@22",
    "php@8.4",
    "php84Packages.composer@latest",
    "php84Extensions.pcov@latest"
  ],
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!' > /dev/null"
    ],
    "scripts": {
      "test": [
        "viv install",
        "php -d pcov.directory=. vendor/bin/phpunit --coverage-clover coverage/clover.xml",
        "php bin/coverage-check.php 50",
        "npm ci",
        "npm run lint:js",
        "npm run lint:css",
        "npm run test:unit",
        "npm run build"
      ]
    }
  }
}

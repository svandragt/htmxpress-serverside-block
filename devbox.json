{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": [
    "php@8.2",
    "php82Packages.composer@latest",
    "nodejs@22"
  ],
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!' > /dev/null"
    ],
    "scripts": {
      "test": [
        "composer install",
        "composer test",
        "npm ci",
        "npm run lint:js",
        "npm run lint:css",
        "npm run build"
      ]
    }
  }
}
